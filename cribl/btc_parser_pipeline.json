{
  "id": "btc_parser",
  "conf": {
    "output": "default",
    "streamtags": [],
    "groups": {},
    "asyncFuncTimeout": 1000,
    "description": "btc_parser_app export CSVs -> Splunk (docs chapter 10.6)",
    "functions": [
      {
        "id": "comment",
        "conf": {
          "comment": "Generated by splunk/build_field_config.py from btc_parser_app/export_schema.py - re-generate and re-import instead of editing. Every top-level field left on the event becomes an indexed field in Splunk; _raw stays the CSV row and the rest is extracted at search time by TA-btc-parser-search."
        }
      },
      {
        "id": "drop",
        "filter": "(sourcetype==\"btc:blocks\" && _raw.startsWith(\"hash,height,\")) || (sourcetype==\"btc:transactions\" && _raw.startsWith(\"block_hash,block_height,\")) || (sourcetype==\"btc:inputs\" && _raw.startsWith(\"block_hash,block_height,\")) || (sourcetype==\"btc:outputs\" && _raw.startsWith(\"block_hash,block_height,\")) || (sourcetype==\"btc:stale_block_headers\" && _raw.startsWith(\"observed_at,height,\")) || (sourcetype==\"btc:sanctioned_tx_events\" && _raw.startsWith(\"observed_at,event,\")) || (sourcetype==\"btc:prices\" && _raw.startsWith(\"date_unix,usd,\"))",
        "description": "CSV header rows (one per part file)",
        "conf": {}
      },
      {
        "id": "serde",
        "filter": "sourcetype==\"btc:blocks\"",
        "description": "btc:blocks: extract every column",
        "conf": {
          "mode": "extract",
          "type": "csv",
          "srcField": "_raw",
          "fields": [
            "hash",
            "height",
            "version",
            "versionHex",
            "merkleroot",
            "time",
            "time_since_prev_block_sec",
            "mediantime",
            "nonce",
            "bits",
            "target",
            "difficulty",
            "chainwork",
            "chainwork_log2",
            "nTx",
            "previousblockhash",
            "strippedsize",
            "size",
            "weight",
            "weight_utilization_pct",
            "block_subsidy_sats",
            "pool_id",
            "pool_name",
            "pool_link",
            "pool_match_method",
            "regular_tx_count",
            "total_vin_count",
            "total_vout_count",
            "coinbase_value_sats",
            "coinbase_vout_count",
            "total_fees_sats",
            "fee_known_tx_count",
            "fee_unknown_tx_count",
            "fee_avg_sats",
            "fee_median_sats",
            "fee_max_sats",
            "fee_rate_avg_sat_vb",
            "fee_rate_median_sat_vb",
            "fee_rate_max_sat_vb",
            "effective_fee_rate_sat_vb",
            "regular_input_value_sats",
            "input_value_complete_tx_count",
            "regular_output_value_sats",
            "coin_days_destroyed_btc",
            "tx_vsize_avg",
            "tx_vsize_median",
            "tx_vsize_max",
            "segwit_tx_count",
            "rbf_tx_count",
            "taproot_input_tx_count",
            "taproot_output_tx_count",
            "op_return_tx_count",
            "op_return_output_count",
            "op_return_script_bytes",
            "witness_input_count",
            "witness_item_count",
            "witness_data_bytes",
            "scriptsig_bytes",
            "scriptpubkey_bytes",
            "vin_type_nonstandard_count",
            "vin_type_pubkey_count",
            "vin_type_pubkeyhash_count",
            "vin_type_scripthash_count",
            "vin_type_multisig_count",
            "vin_type_nulldata_count",
            "vin_type_witness_v0_keyhash_count",
            "vin_type_witness_v0_scripthash_count",
            "vin_type_witness_v1_taproot_count",
            "vin_type_witness_unknown_count",
            "vin_type_anchor_count",
            "vin_type_other_count",
            "vout_type_nonstandard_count",
            "vout_type_pubkey_count",
            "vout_type_pubkeyhash_count",
            "vout_type_scripthash_count",
            "vout_type_multisig_count",
            "vout_type_nulldata_count",
            "vout_type_witness_v0_keyhash_count",
            "vout_type_witness_v0_scripthash_count",
            "vout_type_witness_v1_taproot_count",
            "vout_type_witness_unknown_count",
            "vout_type_anchor_count",
            "vout_type_other_count"
          ]
        }
      },
      {
        "id": "eval",
        "filter": "sourcetype==\"btc:blocks\"",
        "description": "btc:blocks: _time from time",
        "conf": {
          "add": [
            {
              "name": "_time",
              "value": "Number(time)"
            }
          ]
        }
      },
      {
        "id": "serde",
        "filter": "sourcetype==\"btc:transactions\"",
        "description": "btc:transactions: extract block_height, is_coinbase, version, vin_count, vout_count",
        "conf": {
          "mode": "extract",
          "type": "csv",
          "srcField": "_raw",
          "fields": [
            "block_hash",
            "block_height",
            "block_time",
            "tx_index",
            "txid",
            "wtxid",
            "is_coinbase",
            "version",
            "size",
            "vsize",
            "weight",
            "locktime",
            "fee_sats",
            "fee_source",
            "fee_rate_sat_vb",
            "input_value_sats",
            "output_value_sats",
            "output_value_min_sats",
            "output_value_max_sats",
            "output_value_avg_sats",
            "vin_count",
            "vout_count",
            "prevout_value_known_count",
            "prevout_height_known_count",
            "generated_input_count",
            "input_age_min_blocks",
            "input_age_max_blocks",
            "input_age_avg_blocks",
            "input_age_value_weighted_avg_blocks",
            "coin_days_destroyed_btc",
            "witness_input_count",
            "witness_item_count",
            "witness_data_bytes",
            "scriptsig_bytes",
            "scriptpubkey_bytes",
            "signals_rbf",
            "op_return_count",
            "op_return_script_bytes",
            "zero_value_output_count",
            "vin_type_nonstandard_count",
            "vin_type_pubkey_count",
            "vin_type_pubkeyhash_count",
            "vin_type_scripthash_count",
            "vin_type_multisig_count",
            "vin_type_nulldata_count",
            "vin_type_witness_v0_keyhash_count",
            "vin_type_witness_v0_scripthash_count",
            "vin_type_witness_v1_taproot_count",
            "vin_type_witness_unknown_count",
            "vin_type_anchor_count",
            "vin_type_other_count",
            "vout_type_nonstandard_count",
            "vout_type_pubkey_count",
            "vout_type_pubkeyhash_count",
            "vout_type_scripthash_count",
            "vout_type_multisig_count",
            "vout_type_nulldata_count",
            "vout_type_witness_v0_keyhash_count",
            "vout_type_witness_v0_scripthash_count",
            "vout_type_witness_v1_taproot_count",
            "vout_type_witness_unknown_count",
            "vout_type_anchor_count",
            "vout_type_other_count"
          ],
          "keep": [
            "block_height",
            "is_coinbase",
            "version",
            "vin_count",
            "vout_count",
            "block_time"
          ]
        }
      },
      {
        "id": "eval",
        "filter": "sourcetype==\"btc:transactions\"",
        "description": "btc:transactions: _time from block_time",
        "conf": {
          "add": [
            {
              "name": "_time",
              "value": "Number(block_time)"
            }
          ],
          "remove": [
            "block_time"
          ]
        }
      },
      {
        "id": "serde",
        "filter": "sourcetype==\"btc:inputs\"",
        "description": "btc:inputs: extract block_height, is_coinbase, prevout_type, prevout_generated, relative_locktime_type",
        "conf": {
          "mode": "extract",
          "type": "csv",
          "srcField": "_raw",
          "fields": [
            "block_hash",
            "block_height",
            "block_time",
            "tx_index",
            "txid",
            "is_coinbase",
            "input_index",
            "prevout_txid",
            "prevout_vout",
            "value_sats",
            "prevout_height",
            "input_age_blocks",
            "prevout_generated",
            "prevout_type",
            "prevout_address",
            "scriptsig_bytes",
            "coinbase_hex",
            "witness_item_count",
            "witness_data_bytes",
            "sequence",
            "signals_rbf",
            "relative_locktime_type",
            "relative_locktime_value"
          ],
          "keep": [
            "block_height",
            "is_coinbase",
            "prevout_type",
            "prevout_generated",
            "relative_locktime_type",
            "block_time"
          ]
        }
      },
      {
        "id": "eval",
        "filter": "sourcetype==\"btc:inputs\"",
        "description": "btc:inputs: _time from block_time",
        "conf": {
          "add": [
            {
              "name": "_time",
              "value": "Number(block_time)"
            }
          ],
          "remove": [
            "block_time"
          ]
        }
      },
      {
        "id": "serde",
        "filter": "sourcetype==\"btc:outputs\"",
        "description": "btc:outputs: extract block_height, is_coinbase, script_type",
        "conf": {
          "mode": "extract",
          "type": "csv",
          "srcField": "_raw",
          "fields": [
            "block_hash",
            "block_height",
            "block_time",
            "tx_index",
            "txid",
            "is_coinbase",
            "output_index",
            "value_sats",
            "script_type",
            "script_bytes",
            "address",
            "is_op_return"
          ],
          "keep": [
            "block_height",
            "is_coinbase",
            "script_type",
            "block_time"
          ]
        }
      },
      {
        "id": "eval",
        "filter": "sourcetype==\"btc:outputs\"",
        "description": "btc:outputs: _time from block_time",
        "conf": {
          "add": [
            {
              "name": "_time",
              "value": "Number(block_time)"
            }
          ],
          "remove": [
            "block_time"
          ]
        }
      },
      {
        "id": "serde",
        "filter": "sourcetype==\"btc:stale_block_headers\"",
        "description": "btc:stale_block_headers: extract every column",
        "conf": {
          "mode": "extract",
          "type": "csv",
          "srcField": "_raw",
          "fields": [
            "observed_at",
            "height",
            "hash",
            "status",
            "header_hex",
            "header_valid",
            "source",
            "chaintip_status",
            "branchlen",
            "version",
            "previousblockhash",
            "merkleroot",
            "time",
            "bits",
            "nonce"
          ]
        }
      },
      {
        "id": "eval",
        "filter": "sourcetype==\"btc:stale_block_headers\"",
        "description": "btc:stale_block_headers: _time from observed_at",
        "conf": {
          "add": [
            {
              "name": "_time",
              "value": "Date.parse(observed_at) / 1000"
            }
          ]
        }
      },
      {
        "id": "serde",
        "filter": "sourcetype==\"btc:sanctioned_tx_events\"",
        "description": "btc:sanctioned_tx_events: extract every column",
        "conf": {
          "mode": "extract",
          "type": "csv",
          "srcField": "_raw",
          "fields": [
            "observed_at",
            "event",
            "txid",
            "direction",
            "io_index",
            "address",
            "value_sats",
            "value_btc",
            "name",
            "first_name",
            "sanctions_programs",
            "list_file",
            "tx_fee_btc",
            "tx_vsize",
            "first_seen_at",
            "block_height",
            "block_hash",
            "replaced_by_txid",
            "source",
            "detail"
          ]
        }
      },
      {
        "id": "eval",
        "filter": "sourcetype==\"btc:sanctioned_tx_events\"",
        "description": "btc:sanctioned_tx_events: _time from observed_at",
        "conf": {
          "add": [
            {
              "name": "_time",
              "value": "Date.parse(observed_at) / 1000"
            }
          ]
        }
      },
      {
        "id": "serde",
        "filter": "sourcetype==\"btc:prices\"",
        "description": "btc:prices: extract every column",
        "conf": {
          "mode": "extract",
          "type": "csv",
          "srcField": "_raw",
          "fields": [
            "date_unix",
            "usd",
            "eur"
          ]
        }
      },
      {
        "id": "eval",
        "filter": "sourcetype==\"btc:prices\"",
        "description": "btc:prices: _time from date_unix",
        "conf": {
          "add": [
            {
              "name": "_time",
              "value": "Number(date_unix)"
            }
          ]
        }
      },
      {
        "id": "code",
        "filter": "sourcetype.startsWith('btc:')",
        "description": "Drop empty CSV values (nulls) instead of sending empty indexed fields",
        "conf": {
          "code": "for (const k of Object.keys(__e)) { if (__e[k] === '') delete __e[k]; }",
          "maxNumOfIterations": 5000
        }
      }
    ]
  }
}
